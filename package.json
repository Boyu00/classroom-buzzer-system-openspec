{
  "name": "classroom-buzzer-system-openspec",
  "version": "0.1.0",
  "private": true,
  "description": "課堂搶答系統（OpenSpec 組）",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "test": "node --test",
    "db:migrate": "node --env-file-if-exists=.env src/storage/migrate.js"
  },
  "dependencies": {
    "express": "5.3.0"
  },
  "devDependencies": {
    "linkedom": "0.18.12"
  }
}
